@page "/not-found"
@layout MainLayout

<PageTitle>Not found - Text Feed Combiner</PageTitle>

<MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center"
          Style="border:1px dashed var(--mud-palette-divider); max-width:520px; margin:0 auto;">
    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary" />
    <MudText Typo="Typo.h6" Class="mt-3">Page not found</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
        That address does not match anything in this app. If you followed a download
        link, it may simply have expired - combine the files again to get a new one.
    </MudText>
    <MudButton Href="/combine" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Outlined.MergeType">
        Go to combine
    </MudButton>
</MudPaper>
