@page "/combine"
@using FeedCombiner.Core
@using FeedCombiner.Web
@inject FeedCombinerService Combiner
@inject MarketplaceDetector Detector
@inject CombinedFileStore Files

<PageTitle>Combine feeds - Text Feed Combiner</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Combine feed files</MudText>
<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-8">
    Upload the marketplace feed files you want merged. Duplicate lines are dropped,
    and the output is named after the marketplace it recognises.
</MudText>

<MudPaper Elevation="0" Class="pa-8 mb-5" Style="border:1px solid var(--mud-palette-divider);">
    <MudText Typo="Typo.h6" Class="mb-4">1 &nbsp;·&nbsp; Choose files</MudText>

    @* MudFileUpload renders its own button. ActivatorContent is not a parameter in
       MudBlazor 9, so a custom activator here is silently ignored. *@
    <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesChosen" Accept=".txt,.tsv,.csv"
                   MaximumFileCount="MaxFiles" Class="feed-upload" />

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-3">
        Up to @MaxFiles files, @(MaxFileBytes / 1024 / 1024) MB each,
        @(MaxTotalBytes / 1024 / 1024) MB total. Text files only.
    </MudText>

    @if (chosen.Count > 0)
    {
        <MudList T="string" Dense="true" Class="mt-4">
            @foreach (var f in chosen)
            {
                <MudListItem T="string" Icon="@Icons.Material.Outlined.Description">
                    <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                        <MudText Typo="Typo.body2" Style="font-family:Consolas,monospace;">@f.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@f.LineCount lines</MudText>
                    </div>
                </MudListItem>
            }
        </MudList>
    }

    @if (errors.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4" Dense="true">
            <MudText Typo="Typo.body2" Class="mb-1"><b>Some files were skipped:</b></MudText>
            @foreach (var e in errors)
            {
                <MudText Typo="Typo.body2">@e</MudText>
            }
        </MudAlert>
    }
</MudPaper>

@if (chosen.Count > 0)
{
    <MudPaper Elevation="0" Class="pa-8 mb-5" Style="border:1px solid var(--mud-palette-divider);">
        <MudText Typo="Typo.h6" Class="mb-4">2 &nbsp;·&nbsp; Options</MudText>

        <MudSwitch @bind-Value="options.RemoveDuplicates" Color="Color.Primary" Class="d-block">
            Remove duplicate lines
        </MudSwitch>
        <MudSwitch @bind-Value="options.FirstLineIsHeader" Color="Color.Primary" Class="d-block">
            First line of each file is a header (keep only the first)
        </MudSwitch>
        <MudSwitch @bind-Value="options.SkipBlankLines" Color="Color.Primary" Class="d-block">
            Skip blank lines
        </MudSwitch>
        <MudSwitch @bind-Value="options.TrimLineEnds" Color="Color.Primary" Class="d-block">
            Trim trailing whitespace before comparing
        </MudSwitch>

        <MudButton OnClick="RunCombine" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   Class="mt-5" StartIcon="@Icons.Material.Outlined.MergeType">
            Combine
        </MudButton>
    </MudPaper>
}

@if (result is not null)
{
    <MudPaper Elevation="0" Class="pa-8" Style="border:1px solid var(--mud-palette-divider);">
        <MudText Typo="Typo.h6" Class="mb-4">3 &nbsp;·&nbsp; Result</MudText>

        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="6" sm="4" md="2"><Stat Label="Files" Value="@result.FilesProcessed.ToString()" /></MudItem>
            <MudItem xs="6" sm="4" md="2"><Stat Label="Lines read" Value="@result.LinesRead.ToString()" /></MudItem>
            <MudItem xs="6" sm="4" md="3"><Stat Label="Duplicates removed" Value="@result.DuplicatesRemoved.ToString()" /></MudItem>
            <MudItem xs="6" sm="4" md="2"><Stat Label="Blanks skipped" Value="@result.BlanksSkipped.ToString()" /></MudItem>
            <MudItem xs="6" sm="4" md="3"><Stat Label="Lines written" Value="@result.LinesWritten.ToString()" /></MudItem>
        </MudGrid>

        <div class="d-flex flex-wrap align-center gap-2 mb-4">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                @(result.Marketplace ?? "No marketplace detected")
            </MudChip>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Output: <span style="font-family:Consolas,monospace;">@result.OutputName</span>
            </MudText>
        </div>

        @if (result.LinesWritten == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Nothing to download - every line was a duplicate or blank.
            </MudAlert>
        }
        else
        {
            <MudButton Href="@downloadUrl" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Outlined.Download" Class="mb-5">
                Download
            </MudButton>

            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">PREVIEW</MudText>
            <pre class="preview">@Preview()</pre>

            @if (result.LinesWritten > PreviewLines)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Showing the first @PreviewLines of @result.LinesWritten lines.
                </MudText>
            }
        }
    </MudPaper>
}

@code {
    private const int MaxFiles = 20;
    private const long MaxFileBytes = 5L * 1024 * 1024;
    private const long MaxTotalBytes = 20L * 1024 * 1024;
    private const int PreviewLines = 15;

    private readonly List<FeedFile> chosen = new();
    private readonly List<string> errors = new();
    private CombineOptions options = new();
    private CombineResult? result;
    private string? downloadUrl;

    private async Task OnFilesChosen(IReadOnlyList<IBrowserFile> files)
    {
        chosen.Clear();
        errors.Clear();
        result = null;
        downloadUrl = null;

        long total = 0;

        foreach (var file in files)
        {
            if (file.Size > MaxFileBytes)
            {
                errors.Add($"{file.Name} is larger than {MaxFileBytes / 1024 / 1024} MB.");
                continue;
            }

            if (total + file.Size > MaxTotalBytes)
            {
                errors.Add($"{file.Name} would push the upload past the {MaxTotalBytes / 1024 / 1024} MB total.");
                continue;
            }

            total += file.Size;

            var lines = new List<string>();

            using var reader = new StreamReader(file.OpenReadStream(MaxFileBytes));
            while (await reader.ReadLineAsync() is { } line)
            {
                lines.Add(line);
            }

            chosen.Add(new FeedFile(file.Name, lines));
        }

        if (chosen.Count == 0 && errors.Count == 0)
        {
            errors.Add("No readable text files were selected.");
        }
    }

    private void RunCombine()
    {
        // The domain throws when handed nothing; the screen should never let that
        // happen, but the guard keeps the failure a message rather than a crash.
        if (chosen.Count == 0)
        {
            errors.Add("Choose at least one file first.");
            return;
        }

        result = Combiner.Combine(chosen, options);

        // Park the finished file so the download endpoint can serve it.
        downloadUrl = result.LinesWritten == 0
            ? null
            : $"/download/{Files.Put(result.OutputName, result.ToText())}";
    }

    private string Preview() =>
        string.Join(Environment.NewLine, result!.Lines.Take(PreviewLines));
}
